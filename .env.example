# Copy this file to .env and set your real key.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local tokenizer used for the input/output token counters in the sidebar.
# Examples: o200k_base, cl100k_base, p50k_base, r50k_base.
TOKENIZER_ENCODING=o200k_base
MAX_GENERATION_TOKENS=4096
MAX_REPAIR_TOKENS=4096

# Output validation fails closed unless javac is available.
JAVA_RELEASE=17
REQUIRE_JAVAC=true
JAVA_GUARDRAIL_TEMP_DIR=.java_guardrail_tmp
# Optional portable JDK compiler path when javac is not installed system-wide.
# JAVAC_PATH=C:\\path\\to\\jdk-17\\bin\\javac.exe

# Strong local semantic and prompt-injection guardrails.
# Set true for company deployment after installing requirements.txt.
ENABLE_LOCAL_MODEL_GUARDRAILS=true
REQUIRE_LOCAL_MODEL_GUARDRAILS=true
JAVA_SCOPE_MIN_SCORE=0.55
JAVA_SCOPE_MIN_MARGIN=0.06
PROMPT_GUARD_THRESHOLD=0.70
# Default is public/non-gated. Meta's gated model can be selected explicitly:
# PROMPT_GUARD_MODEL=meta-llama/Prompt-Guard-86M
